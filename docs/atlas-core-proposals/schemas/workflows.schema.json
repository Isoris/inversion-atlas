{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-core/schemas/workflows.schema.json",
  "title": "Workflows registry v1",
  "description": "Per-atlas registry of cluster-side producer workflows and their typed outputs. Authored as part of Phase 0 of the 4-atlas split. See SPEC_workflows_v1.md.",
  "type": "object",
  "required": ["atlas_id", "version", "workflows"],
  "additionalProperties": false,
  "properties": {
    "$schema":  { "type": "string" },
    "atlas_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$",
      "description": "Slug of the owning atlas. Must match atlases/_index.json entry."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Schema-instance version (not the atlas-core SPEC version)."
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "required": ["workflow_id", "label", "version", "stages", "runners", "outputs_root", "cohort_id"],
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "description": "Unique within the atlas."
        },
        "label":       { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "version":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "knob_schema_ref": {
          "type": "string",
          "description": "Atlas-relative path to a JSON Schema describing the workflow's knobs."
        },
        "default_knob_hash": {
          "type": "string",
          "description": "SHA1 prefix of the default knob set, or 'auto' to derive from knob_schema_ref defaults."
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        },
        "runners": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runner" }
        },
        "post_run_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/post_run_step" }
        },
        "outputs_root": {
          "type": "string",
          "description": "Atlas-relative directory path. All workflow outputs live under here."
        },
        "status_file": {
          "type": "string",
          "description": "Atlas-relative path to the workflow's status.json. Defaults to outputs_root/_status.json."
        },
        "cohort_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "description": "Cohort this workflow's outputs belong to. Cross-validated against cohorts.registry.json."
        },
        "reference_id": {
          "type": "string",
          "description": "Reference assembly id (e.g. fClaHyb_Gar_LG)."
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["stage_id", "script", "produces"],
      "additionalProperties": false,
      "properties": {
        "stage_id":              { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
        "label":                 { "type": "string", "maxLength": 200 },
        "script":                { "type": "string", "description": "Atlas-relative path to the stage's runnable script." },
        "produces":              { "type": "array", "items": { "type": "string" } },
        "consumes":              { "type": "array", "items": { "type": "string" } },
        "estimated_runtime_min": { "type": "number", "minimum": 0 },
        "estimated_ram_gb":      { "type": "number", "minimum": 0 }
      }
    },
    "runner": {
      "type": "object",
      "required": ["runner_id", "script"],
      "additionalProperties": false,
      "properties": {
        "runner_id": {
          "type": "string",
          "enum": ["laptop", "slurm", "cloud", "local_test", "manual"]
        },
        "script":    { "type": "string", "description": "Atlas-relative path to the driver script." },
        "preset":    { "type": "string", "description": "Free-form preset label (e.g. 'focal_only_2cpu_skiplargetargets')." }
      }
    },
    "post_run_step": {
      "type": "object",
      "required": ["step", "script"],
      "additionalProperties": false,
      "properties": {
        "step":   { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "script": { "type": "string" }
      }
    }
  }
}
