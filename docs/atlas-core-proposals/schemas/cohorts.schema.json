{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-core/schemas/cohorts.schema.json",
  "title": "Cohorts registry v1",
  "description": "Global atlas-core registry of cohorts + acceptable cross-cohort coordinate handoffs. Authored as part of Phase 0 of the 4-atlas split. See SPEC_cohorts_v1.md.",
  "type": "object",
  "required": ["version", "cohorts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cohort" }
    },
    "cross_reference_handoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoff" }
    }
  },
  "$defs": {
    "cohort": {
      "type": "object",
      "required": ["cohort_id", "label", "reference_id", "scope", "atlases"],
      "additionalProperties": false,
      "properties": {
        "cohort_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "description": "Unique slug for this cohort."
        },
        "label":   { "type": "string", "minLength": 1, "maxLength": 200 },
        "species": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of species names (Genus species)."
        },
        "reference_id": {
          "type": "string",
          "description": "Reference assembly id all layers in this cohort align against."
        },
        "n_samples_approx": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "description": "Free-text scope description (e.g. 'inversion_atlas_main_cohort', 'future_paper', 'assembly_paper_only')."
        },
        "atlases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,31}$"
          },
          "description": "List of atlas_ids that this cohort appears in. Empty array = cohort is reserved but not currently used."
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["handoff_id", "from_cohort", "to_cohort", "via_layer_pattern", "handoff_kind", "rationale"],
      "additionalProperties": false,
      "properties": {
        "handoff_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "from_cohort": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "to_cohort": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "via_layer_pattern": {
          "type": "string",
          "description": "Regex matched against '<atlas_id>.<layer_id>'. Must compile as a JS RegExp."
        },
        "handoff_kind": {
          "type": "string",
          "enum": ["coordinate_handoff", "reference_join", "annotation_only", "none_yet"],
          "description": "What's transferring. 'coordinate_handoff' = BP-style genomic coordinates with no per-sample claims. 'reference_join' = reference-assembly metadata. 'annotation_only' = annotation rows. 'none_yet' = handoff declared but not in use."
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000,
          "description": "Why this read is biologically safe. Required, audited at review."
        }
      }
    }
  }
}
