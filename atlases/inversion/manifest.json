  "server": {
    "_doc": "Server moved to atlas-core/server/ (turn 'core-server-unify'). Every endpoint here (popstats / LD / dosage / file / compute) is generic plumbing — the inversion atlas reaches it the same way every other atlas will. See atlas-core/server/SERVER_README.md.",
    "entry": "server/atlas_server.py",
    "config_example": "server/atlas_server.config.example.yaml",
    "default_url": "http://localhost:8000",
    "requirements": "server/requirements.txt"
  },
  "engines_dir": "atlases/inversion/engines/",
  "analysis_dir": "atlases/inversion/analysis/",
  "css_dir": "atlases/inversion/css/",
  "stylesheets": [
    "atlases/inversion/css/inversion.css"
  ],
  "_stylesheets_doc": "Atlas-wide stylesheets, loaded by the shell at atlas-register time. Currently one big bundle (extracted verbatim from the legacy monolith). Future work: split into per-page stylesheets (atlases/inversion/css/pages/page1.css etc.) and reference them from each page entry's `stylesheet` field below — the router loads page-stylesheet on mount.",
  "scope_pickers": [
    {
      "slot": "activeChrom",
      "label": "chromosome",
      "options": ["LG28"],
      "shared": true
    }
  ],
  "_scope_pickers_doc": "Pickers rendered in the shell's #scopebar (sticky strip below the topbar). Each picker drives an AtlasState slot via setActiveChrom / setActiveCandidate / generic emit. The `options` array lists the values currently shipped with this atlas package; in the demo build only LG28 precomp is included. When data for additional chromosomes is staged into atlases/inversion/data/precomp/, extend this list. Future work: replace the static list with a discovery file (e.g. data/precomp/_index.json) so the shell can populate it dynamically.",
