{
  "_doc": "Cluster-side producer workflows for the cross-species atlas. Per SPEC_workflows_v1 (docs/atlas-core-proposals/SPEC_workflows_v1.md). Phase 1a declares two workflows: bp_atlas_pipeline (sequence) + gene_order_consolidation (gene-order). They are independent method families; their consolidation is the canonical 'cross-method validated' Tier 1 evidence.",
  "atlas_id": "cross-species",
  "version": "1.0",
  "workflows": [
    {
      "workflow_id": "bp_atlas_pipeline",
      "label": "BP_ATLAS — cross-species breakpoints (sequence method)",
      "description": "Two-pass wfmash + event extraction + zone clustering + both-anchor reciprocity. Produces results_bpatlas/ tree. See engines/producers/bp_atlas/scripts/. Source: COMPARATIVE_BREAKPOINTS_MASTER_20260522 bundle, Quentin 2026-05-23.",
      "version": "1.0",
      "knob_schema_ref": "engines/producers/bp_atlas/config/00_bpatlas_config.sh",
      "default_knob_hash": "auto",
      "cohort_id": "f1_hybrid_cga_cma",
      "reference_id": "fClaHyb_Gar_LG",
      "outputs_root": "data/breakpoints/results_bpatlas/",
      "status_file":  "data/breakpoints/results_bpatlas/_status.json",
      "stages": [
        {
          "stage_id": "BP1",
          "label": "pairwise wfmash (two-pass A100k + B500k)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP1_pairwise_wfmash.sh",
          "produces": ["bp_atlas_passA_paf_v1", "bp_atlas_passB_paf_v1"],
          "consumes": ["haplotype_manifest_v1"],
          "estimated_runtime_min": 4320,
          "estimated_ram_gb": 5
        },
        {
          "stage_id": "BP2",
          "label": "per-PAF event extraction (--min-mapq 1; PATCHED for wfmash)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP2_call_breakpoints.py",
          "produces": ["bp_atlas_events_v1"],
          "consumes": ["bp_atlas_passA_paf_v1"],
          "estimated_runtime_min": 30
        },
        {
          "stage_id": "BP3",
          "label": "cluster events into zones (per anchor)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP3_cluster_zones.py",
          "produces": ["bp_atlas_zones_v1"],
          "consumes": ["bp_atlas_events_v1", "bp_atlas_passB_paf_v1"],
          "estimated_runtime_min": 10
        },
        {
          "stage_id": "BP3c",
          "label": "reciprocity (both-anchor validated zones)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP3c_reciprocity.py",
          "produces": ["bp_atlas_reciprocity_v1"],
          "consumes": ["bp_atlas_zones_v1"],
          "estimated_runtime_min": 5
        },
        {
          "stage_id": "BP5",
          "label": "prepare atlas data + PAF arcs (BP5 figure inputs)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP5_prep_atlas_data.py",
          "produces": ["atlas_data_v1", "bp_atlas_arcs_v1"],
          "consumes": ["bp_atlas_zones_v1"],
          "estimated_runtime_min": 5
        },
        {
          "stage_id": "BP6",
          "label": "joint A-E classification (manuscript table)",
          "script": "engines/producers/bp_atlas/scripts/STEP_BP6_joint_classify.py",
          "produces": ["joint_candidates_v1"],
          "consumes": ["bp_atlas_zones_v1", "bp_atlas_reciprocity_v1"],
          "estimated_runtime_min": 5
        }
      ],
      "runners": [
        {
          "runner_id": "laptop",
          "script": "engines/producers/bp_atlas/runners/run_bp_atlas_LAPTOP.sh",
          "preset": "focal_only_2cpu_skiplargetargets"
        },
        {
          "runner_id": "slurm",
          "script": "engines/producers/bp_atlas/runners/SLURM_run_bp_atlas_PARALLEL.sh",
          "preset": "all_pairs_80cpu_200gb"
        }
      ],
      "post_run_chain": [
        {
          "step": "fold_into_clusters",
          "script": "engines/producers/bp_atlas/runners/run_fold_into_clusters_LAPTOP.sh"
        }
      ]
    },
    {
      "workflow_id": "gene_order_consolidation",
      "label": "Gene-order breakpoints + cross-method consolidation",
      "description": "Independent method family — BUSCO single-copy orthologs from macrosyntR wide tables (18sp + 5sp). Tolerance-cluster consolidation with cross_method flag (gene_order AND wfmash agree ≤ tol). 500kb → 1kb sweep proves stability.",
      "version": "1.0",
      "default_knob_hash": "auto",
      "cohort_id": "f1_hybrid_cga_cma",
      "reference_id": "fClaHyb_Gar_LG",
      "outputs_root": "data/breakpoints/",
      "status_file":  "data/breakpoints/_status_gene_order.json",
      "stages": [
        {
          "stage_id": "GO1",
          "label": "extract edges from macrosyntR wide ortholog table",
          "script": "engines/producers/gene_order/wide_orthologs_to_breakpoints.py",
          "produces": ["synteny_18sp_v1", "synteny_5sp_v1"],
          "consumes": [],
          "estimated_runtime_min": 5
        },
        {
          "stage_id": "GO2",
          "label": "fold CS-caller JSON breakpoints into one table",
          "script": "engines/producers/gene_order/csbp_json_to_breakpoints.py",
          "produces": [],
          "consumes": [],
          "estimated_runtime_min": 2
        },
        {
          "stage_id": "GO3",
          "label": "tolerance-cluster consolidation (cross_method flag)",
          "script": "engines/producers/gene_order/cluster_breakpoints.py",
          "produces": ["breakpoints_consolidated_v1", "pairwise_summary_v1", "tolerance_sweep_v1"],
          "consumes": ["synteny_18sp_v1", "synteny_5sp_v1", "bp_atlas_reciprocity_v1"],
          "estimated_runtime_min": 5
        }
      ],
      "runners": [
        {
          "runner_id": "laptop",
          "script": "engines/producers/bp_atlas/runners/run_fold_into_clusters_LAPTOP.sh",
          "preset": "default"
        }
      ]
    }
  ]
}
